#!/bin/sh
# ==============================================================================
# Ru-Beacon pre-push Hook (Hard Guard)
# Prevents convention violations even if committed with --no-verify
# ==============================================================================

remote="$1"
url="$2"

# 0. 사용자 명시적 푸시 승인 게이트 (User Approval Gate)
if [ "$USER_CONFIRMED_PUSH" != "true" ]; then
    echo ""
    echo "================================================================================"
    echo "[PUSH REJECTED BY HARD GUARD] 사용자 푸시 승인(User Approval Gate) 누락!"
    echo "--------------------------------------------------------------------------------"
    echo "Ru-Beacon 거버넌스 정책: 에이전트의 단독 git push는 엄격히 금지됩니다."
    echo "원격 저장소 푸시는 사용자의 명시적 승인을 확인한 후에만 실행할 수 있습니다."
    echo ""
    echo "승인 확인 후 푸시 실행 방법:"
    echo "  PowerShell: \$env:USER_CONFIRMED_PUSH='true'; git push origin main"
    echo "  Bash/Sh:    USER_CONFIRMED_PUSH=true git push origin main"
    echo "================================================================================"
    echo ""
    exit 1
fi

zero_oid="0000000000000000000000000000000000000000"

FORMAT_PATTERN="^(feat|fix|refactor|docs|test|chore|style|perf|ci)(\([a-z0-9_-]+\))?: .*[^.]$"

while read local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "$zero_oid" ]; then
        continue
    fi

    if [ "$remote_oid" = "$zero_oid" ]; then
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi

    for commit in $(git rev-list "$range"); do
        msg=$(git log -1 --pretty=%B "$commit" | head -n 1)
        if echo "$msg" | grep -qE "^(Merge |Revert |v[0-9])"; then
            continue
        fi

        if ! echo "$msg" | grep -qE "$FORMAT_PATTERN" || ! echo "$msg" | grep -qE "[가-힣]"; then
            echo ""
            echo "================================================================================"
            echo "[PUSH REJECTED BY HARD GUARD] 컨벤션 위반 커밋이 포함되어 있습니다!"
            echo "--------------------------------------------------------------------------------"
            echo "위반 커밋 ($commit): $msg"
            echo "푸시 전에 'git commit --amend' 또는 'git rebase'로 메시지를 수정하십시오."
            echo "================================================================================"
            echo ""
            exit 1
        fi
    done
done

exit 0
