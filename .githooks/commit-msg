#!/bin/sh
# ==============================================================================
# Ru-Beacon commit-msg Hook (Hard Guard)
# Enforces: <type>(<scope>): <한글 요약> (Conventional Commits)
# ==============================================================================

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" | head -n 1)

# Merge, Revert, Tag 커밋은 예외 허용
if echo "$COMMIT_MSG" | grep -qE "^(Merge |Revert |v[0-9])"; then
    exit 0
fi

# 0. docs 커밋 타입 단독 사용 차단 가드 (Atomic Co-located Commit Enforcer)
if [ "$ALLOW_DOCS_ONLY" != "true" ]; then
    if echo "$COMMIT_MSG" | grep -qE "^docs(\([a-z0-9_-]+\))?:"; then
        echo ""
        echo "================================================================================"
        echo "[COMMIT REJECTED BY HARD GUARD] docs 커밋 타입 단독 사용 금지!"
        echo "--------------------------------------------------------------------------------"
        echo "입력된 커밋 메시지: $COMMIT_MSG"
        echo ""
        echo "Ru-Beacon 하네스 정책: 문서화는 독립 docs 커밋이 아닌, 기능 구현(feat) 또는"
        echo "리팩터링(refactor) 커밋에 코드/테스트와 함께 원자적으로 결합되어야 합니다."
        echo ""
        echo "올바른 방식:"
        echo "  - feat(worker): 워커 안정성 구현 및 엔지니어링 일지 기록"
        echo "  - refactor(api): 분산 세션 라우팅 정리 및 체크리스트 갱신"
        echo "(불가피한 단독 문서 커밋 예외 허용: ALLOW_DOCS_ONLY=true git commit ...)"
        echo "================================================================================"
        echo ""
        exit 1
    fi
fi

# 1. 전체 포맷 및 끝 마침표 금지 검증
# Type: feat, fix, refactor, docs, test, chore, style, perf, ci
# Scope: 선택 사항 (영문 소문자, 숫자, 하이픈, 언더스코어)
# Subject: 끝에 마침표(.) 금지
FORMAT_PATTERN="^(feat|fix|refactor|docs|test|chore|style|perf|ci)(\([a-z0-9_-]+\))?: .*[^.]$"

if ! echo "$COMMIT_MSG" | grep -qE "$FORMAT_PATTERN"; then
    echo ""
    echo "================================================================================"
    echo "[COMMIT REJECTED BY HARD GUARD] 커밋 메시지 포맷 위반!"
    echo "--------------------------------------------------------------------------------"
    echo "입력된 커밋 메시지: $COMMIT_MSG"
    echo ""
    echo "올바른 포맷: <type>(<scope>): <한글 요약>"
    echo "  - Type: feat, fix, refactor, docs, test, chore, style, perf, ci"
    echo "  - Scope: 선택 사항 (영문 소문자)"
    echo "  - Subject: 한글 요약 (끝에 마침표 금지)"
    echo ""
    echo "예시: feat(auth): 마인크래프트 계정 일회성 인증 구현"
    echo "================================================================================"
    echo ""
    exit 1
fi

# 2. 한글 포함 여부 검증
if ! echo "$COMMIT_MSG" | grep -qE "[가-힣]"; then
    echo ""
    echo "================================================================================"
    echo "[COMMIT REJECTED BY HARD GUARD] 커밋 메시지에 한글 요약이 포함되어야 합니다!"
    echo "--------------------------------------------------------------------------------"
    echo "입력된 커밋 메시지: $COMMIT_MSG"
    echo "컨벤션 규칙에 따라 커밋 설명은 한글로 작성해야 합니다."
    echo "================================================================================"
    echo ""
    exit 1
fi

exit 0
