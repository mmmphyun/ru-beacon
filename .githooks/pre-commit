#!/bin/sh
# ==============================================================================
# Ru-Beacon pre-commit Hook (Hard Guard)
# Automatically runs test suite before allowing any commits
# ==============================================================================

# 1. 단독 문서(docs/ 또는 *.md) 커밋 차단 가드 (Atomic Co-located Commit Enforcer)
if [ "$ALLOW_DOCS_ONLY" != "true" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        NON_DOC_FILES=$(echo "$STAGED_FILES" | grep -vE "^(docs/|.*\.md$|LICENSE)")
        if [ -z "$NON_DOC_FILES" ]; then
            echo ""
            echo "================================================================================"
            echo "[COMMIT REJECTED BY HARD GUARD] 단독 문서(docs/ 및 *.md) 커밋 금지!"
            echo "--------------------------------------------------------------------------------"
            echo "스테이징된 파일:"
            echo "$STAGED_FILES"
            echo ""
            echo "Ru-Beacon 하네스 정책: 문서(일지, 체크리스트 등)는 독립 커밋으로 분리할 수 없으며,"
            echo "반드시 기능 구현(feat) 또는 리팩터링(refactor) 코드/테스트와 함께 원자적으로 결합(Co-located)하여 커밋해야 합니다."
            echo "(불가피한 단독 문서 커밋 예외 허용: ALLOW_DOCS_ONLY=true git commit ...)"
            echo "================================================================================"
            echo ""
            exit 1
        fi
    fi
fi

echo "[PRE-COMMIT HOOK] 실행 전 단위/통합 테스트 자동 검증 수행 중..."

if [ -f "./gradlew" ]; then
    ./gradlew test --daemon
    RESULT=$?
else
    cmd.exe /c ".\gradlew.bat test"
    RESULT=$?
fi

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "================================================================================"
    echo "[COMMIT REJECTED] 단위 테스트 통과에 실패했습니다! (Exit code: $RESULT)"
    echo "테스트를 통과한 정상 상태(Green-State)에서만 커밋이 허용됩니다."
    echo "================================================================================"
    echo ""
    exit 1
fi

echo "[PRE-COMMIT HOOK] 단위/통합 테스트 검증 통과 완료 (Green-State)"
exit 0
