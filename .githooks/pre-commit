#!/bin/sh
# ==============================================================================
# Ru-Beacon pre-commit Hook (Hard Guard)
# Automatically runs test suite before allowing any commits
# ==============================================================================

# 1. 단독 문서(docs/ 또는 *.md) 커밋 가드 (Post-hoc Docs for feat/refactor Allowed)
if [ "$ALLOW_DOCS_ONLY" != "true" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        NON_DOC_FILES=$(echo "$STAGED_FILES" | grep -vE "^(docs/|.*\.md$|LICENSE)")
        if [ -z "$NON_DOC_FILES" ]; then
            PREV_COMMIT_TYPE=$(git log -1 --pretty=format:"%s" 2>/dev/null | grep -oE "^[a-z]+" || true)
            if [ "$PREV_COMMIT_TYPE" = "feat" ] || [ "$PREV_COMMIT_TYPE" = "refactor" ]; then
                echo "[PRE-COMMIT HOOK] 직전 $PREV_COMMIT_TYPE 커밋에 연계된 정당한 사후 문서화(docs)가 승인되었습니다."
            else
                echo ""
                echo "================================================================================"
                echo "[COMMIT REJECTED BY HARD GUARD] 단독 문서(docs/ 및 *.md) 커밋 금지!"
                echo "--------------------------------------------------------------------------------"
                echo "스테이징된 파일:"
                echo "$STAGED_FILES"
                echo ""
                echo "Ru-Beacon 하네스 정책: 직전 커밋이 feat 또는 refactor가 아닌 상태에서는 단독 문서 커밋이 거부됩니다."
                echo "문서는 기능 구현(feat) 또는 리팩터링(refactor) 커밋과 원자적으로 결합하거나,"
                echo "직전 feat/refactor 직후의 docs(log): 또는 docs(milestone): 사후 문서화여야 합니다."
                echo "(불가피한 단독 문서 커밋 예외 허용: ALLOW_DOCS_ONLY=true git commit ...)"
                echo "================================================================================"
                echo ""
                exit 1
            fi
        fi
    fi
fi

# 1.5. 공용 IPv4 하드코딩 누출 차단 가드 (Public IP Leak Guard)
if [ -f "scripts/check-public-ip.sh" ]; then
    sh scripts/check-public-ip.sh --cached
fi

# 1.6. Gitleaks 시크릿 및 공용 IP 정적 스캔 가드 (Local Gitleaks Guard)
if [ -f ".gitleaks.toml" ]; then
    echo "[LEAK-GUARD] Gitleaks 스테이징 diff 스캔 실행 중..."
    export MSYS_NO_PATHCONV=1
    if command -v gitleaks >/dev/null 2>&1; then
        git diff --cached | gitleaks stdin --config=.gitleaks.toml --no-banner
        GITLEAKS_EXIT=$?
    elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        CONFIG_DIR="$(pwd -W 2>/dev/null || pwd)"
        git diff --cached | docker run --rm -i -v "${CONFIG_DIR}/.gitleaks.toml:/config.toml" zricethezav/gitleaks:latest stdin --config=/config.toml --no-banner
        GITLEAKS_EXIT=$?
    else
        echo "[LEAK-GUARD] 로컬에 Gitleaks CLI 또는 Docker가 감지되지 않아 심층 시크릿 스캔을 건너뜁니다."
        GITLEAKS_EXIT=0
    fi

    if [ "$GITLEAKS_EXIT" -ne 0 ]; then
        echo ""
        echo "================================================================================"
        echo "[SECURITY REJECTED] Gitleaks 시크릿 또는 비인가 공용 IP 누출 감지!"
        echo "--------------------------------------------------------------------------------"
        echo "스테이징된 diff에서 비밀키, 인증 토큰 또는 비인가 공용 IP가 감지되었습니다."
        echo "수정 후 다시 커밋하십시오. (정상 식별자일 경우 .gitleaks.toml allowlist 등록)"
        echo "================================================================================"
        echo ""
        exit 1
    fi
    echo "[LEAK-GUARD] Gitleaks 검증 통과"
fi

# 2. 멀티모듈 동시 수정 차단 가드 (Single Module Scope Enforcer)
if [ "$ALLOW_MULTI_MODULE" != "true" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    MODULE_COUNT=$(echo "$STAGED_FILES" | grep -oE "^(api-service|workflow-worker|bot-service|minecraft-plugin|web-dashboard|common)/" | cut -d'/' -f1 | sort -u | wc -l)
    if [ "$MODULE_COUNT" -gt 1 ]; then
        echo ""
        echo "================================================================================"
        echo "[COMMIT REJECTED BY HARD GUARD] 멀티모듈 동시 커밋 금지!"
        echo "--------------------------------------------------------------------------------"
        echo "스테이징된 모듈 목록:"
        echo "$STAGED_FILES" | grep -oE "^(api-service|workflow-worker|bot-service|minecraft-plugin|web-dashboard|common)/" | cut -d'/' -f1 | sort -u
        echo ""
        echo "Ru-Beacon 하네스 정책: 빅뱅 커밋을 방지하기 위해 단일 커밋에는 1개의 서브모듈만 수정되어야 합니다."
        echo "각 모듈 단위(예: common 먼저, 그 다음 worker)로 쪼개어 원자적으로 커밋하십시오."
        echo "(불가피한 멀티모듈 결합 커밋 예외: ALLOW_MULTI_MODULE=true git commit ...)"
        echo "================================================================================"
        echo ""
        exit 1
    fi
fi

# 3. TDD 테스트 동시 커밋 강제 가드 (Test Co-location Enforcer)
if [ "$ALLOW_NO_TEST" != "true" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    HAS_MAIN_CODE=$(echo "$STAGED_FILES" | grep -E "src/main/|web-dashboard/src/(app|components|lib)/")
    HAS_TEST_CODE=$(echo "$STAGED_FILES" | grep -E "src/test/|.*\.test\.(ts|tsx|js)")
    if [ -n "$HAS_MAIN_CODE" ] && [ -z "$HAS_TEST_CODE" ]; then
        echo ""
        echo "================================================================================"
        echo "[COMMIT REJECTED BY HARD GUARD] TDD 위반: 테스트 코드 누락!"
        echo "--------------------------------------------------------------------------------"
        echo "스테이징된 소스 코드:"
        echo "$HAS_MAIN_CODE"
        echo ""
        echo "Ru-Beacon 하네스 정책: 비즈니스 로직(src/main/) 추가/수정 시에는 반드시"
        echo "해당 동작을 검증하는 단위/통합 테스트 코드(src/test/)가 동일 커밋에 포함되어야 합니다."
        echo "(테스트가 필요 없는 순수 리팩터링/문구 수정 예외: ALLOW_NO_TEST=true git commit ...)"
        echo "================================================================================"
        echo ""
        exit 1
    fi
fi

# 4. 원자적 커밋 크기 및 파일 수 상한선 가드 (Atomic Commit Size & File Enforcer)
if [ "$ALLOW_LARGE_COMMIT" != "true" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    FILE_COUNT=$(echo "$STAGED_FILES" | grep -vE "^(docs/|.*\.md$|LICENSE|\.githooks/)" | wc -l)
    if [ "$FILE_COUNT" -gt 4 ]; then
        echo ""
        echo "================================================================================"
        echo "[COMMIT REJECTED BY HARD GUARD] 원자적 커밋 파일 수 초과! ($FILE_COUNT개 파일)"
        echo "--------------------------------------------------------------------------------"
        echo "스테이징된 소스/테스트 파일 목록:"
        echo "$STAGED_FILES" | grep -vE "^(docs/|.*\.md$|LICENSE|\.githooks/)"
        echo ""
        echo "Ru-Beacon 하네스 정책: 1-Task 1-Commit 원칙(atomic-commits)에 따라 단일 커밋은"
        echo "최대 4개 소스/테스트 파일(기능 1~2개 + 테스트 1~2개)로 제한됩니다."
        echo "작업을 원자 단위로 쪼개어 파일별로 분할 커밋(git add <file>)하십시오."
        echo "(불가피한 대규모 파일 변경 예외: ALLOW_LARGE_COMMIT=true git commit ...)"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    CODE_STAT=$(git diff --cached --numstat | grep -vE "^[0-9-]+\s+[0-9-]+\s+(docs/|.*\.md$|LICENSE|\.githooks/)" || true)
    if [ -n "$CODE_STAT" ]; then
        TOTAL_LINES=$(echo "$CODE_STAT" | awk '{sum += $1 + $2} END {print sum}')
        if [ "$TOTAL_LINES" -gt 250 ]; then
            echo ""
            echo "================================================================================"
            echo "[COMMIT REJECTED BY HARD GUARD] 원자적 커밋 라인 수 초과! (코드 변경: $TOTAL_LINES 줄)"
            echo "--------------------------------------------------------------------------------"
            echo "Ru-Beacon 하네스 정책: 1-Task 1-Commit 원칙(atomic-commits)에 따라 단일 커밋의"
            echo "순수 코드 변경량은 최대 250줄로 제한됩니다. (현재: $TOTAL_LINES 줄)"
            echo "작업을 더 작은 단위로 쪼개어 분할 커밋하십시오."
            echo "(불가피한 대규모 코드 변경 예외: ALLOW_LARGE_COMMIT=true git commit ...)"
            echo "================================================================================"
            echo ""
            exit 1
        fi
    fi
fi

echo "[PRE-COMMIT HOOK] 실행 전 단위/통합 테스트 자동 검증 수행 중..."

if [ -f "./gradlew" ]; then
    ./gradlew test --daemon
    RESULT=$?
else
    cmd.exe /c ".\gradlew.bat test"
    RESULT=$?
fi

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "================================================================================"
    echo "[COMMIT REJECTED] 단위 테스트 통과에 실패했습니다! (Exit code: $RESULT)"
    echo "테스트를 통과한 정상 상태(Green-State)에서만 커밋이 허용됩니다."
    echo "================================================================================"
    echo ""
    exit 1
fi

echo "[PRE-COMMIT HOOK] 단위/통합 테스트 검증 통과 완료 (Green-State)"
exit 0
