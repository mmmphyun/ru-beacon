{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Ru-Beacon Platform Overview",
      "type": "row"
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - Used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - Max",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Active Threads & Coroutines",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - Live Threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - Daemon Threads",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_cpu_usage{job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - CPU",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{job=~\"ru-beacon-.*\"}",
          "legendFormat": "{{job}} - System CPU",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Traffic, Latency & Redis Concurrency",
      "type": "row"
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "title": "HTTP Ingress Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ru-beacon-api\"}[1m])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 7,
      "title": "HTTP Latency (P95 / P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"ru-beacon-api\"}[1m])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"ru-beacon-api\"}[1m])) by (le))",
          "legendFormat": "P99 Latency",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 8,
      "title": "Redis Streams Consumer Lag (KEDA Trigger)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_stream_consumer_lag{stream=~\"stream:events:.*\", group=\"worker-group\"}",
          "legendFormat": "{{stream}} Lag",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ru-beacon", "k3s", "observability", "sre"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Ru-Beacon / Platform Observability Dashboard",
  "uid": "rubeacon-platform-sre",
  "version": 1
}
