# ==============================================================================
# Ru-Beacon Local Development Environment Configuration (.env.example)
# 복사하여 .env 파일을 생성한 뒤 로컬 개발에 사용하십시오. (git 추적 제외)
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=rubeacon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://postgres:5432/rubeacon

# Cache & Message Broker (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# API Service
API_PORT=8080
DEV_MOCK_AUTH=true
ENABLE_SIMULATION=true

# Workflow Worker
WORKER_METRICS_PORT=8081

# Web Dashboard
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEV_MOCK=false

# Discord Bot Service (옵션: 실제 봇 토큰 및 길드 연동 시 필요)
DISCORD_BOT_TOKEN=
