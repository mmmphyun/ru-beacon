# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Ensure shell scripts use LF
*.sh text eol=lf
gradlew text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
